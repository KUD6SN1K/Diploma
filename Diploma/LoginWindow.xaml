<Window x:Class="Diploma.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Login"
        Height="460"
        Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">

        <!-- FIXED STRUCTURE -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title -->
            <RowDefinition Height="Auto"/>   <!-- username -->
            <RowDefinition Height="Auto"/>   <!-- password -->
            <RowDefinition Height="Auto"/>   <!-- checkbox -->
            <RowDefinition Height="Auto"/>   <!-- buttons -->
            <RowDefinition Height="60"/>     <!-- ERROR AREA FIXED HEIGHT -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Sign in"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"
                   Grid.Row="0"/>

        <!-- Username -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Username"/>
            <TextBox x:Name="UsernameBox"
                     Height="40"
                     KeyDown="UsernameBox_KeyDown"/>
        </StackPanel>

        <!-- Password -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Password"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="40"
                         KeyDown="PasswordTextBox_KeyDown"/>
        </StackPanel>

        <!-- Remember -->
        <CheckBox x:Name="RememberMeCheckBox"
                  Content="Remember me"
                  Grid.Row="3"
                  Margin="0,10,0,0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Margin="0,15,0,0">

            <Button Content="Login"
                    Click="LoginButton_Click"
                    Height="35"
                    Margin="0,0,0,5"
                    Style="{DynamicResource AccentButtonStyle}"/>

            <Button Content="Create account"
                    Click="CreateAccountButton_Click"
                    Height="35"/>
        </StackPanel>

        <!-- ERROR AREA (copyable) -->
        <Border Grid.Row="5"
        Margin="0,10,0,0">

            <TextBox x:Name="StatusText"
             FontSize="12"
             Foreground="Red"
             Background="Transparent"
             BorderThickness="0"
             IsReadOnly="True"
             IsReadOnlyCaretVisible="False"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Disabled"/>
        </Border>

    </Grid>
</Window>