<Window x:Class="Diploma.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Login" Height="420" Width="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Sign in" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <TextBlock Text="Username" Margin="0,5,0,0"/>
            <TextBox x:Name="UsernameBox" Margin="0,2,0,10" Height="40"
                     KeyDown="UsernameBox_KeyDown"/>

            <TextBlock Text="Password" Margin="0,5,0,0"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,2,0,10" Height="40"
                         KeyDown="PasswordTextBox_KeyDown"/>

            <Button Content="Login" Click="LoginButton_Click"
                    Margin="0,15,0,5" Height="35"
                    Style="{DynamicResource AccentButtonStyle}"/>
            <Button Content="Create account" Click="CreateAccountButton_Click"
                    Height="35"/>
            <ScrollViewer MaxHeight="40" VerticalScrollBarVisibility="Auto"
              Margin="0,10,0,0">
                <TextBlock x:Name="StatusText" Foreground="Red" TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>