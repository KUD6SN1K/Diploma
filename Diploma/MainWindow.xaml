<Window x:Class="Diploma.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Diploma Messenger" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="MessagesListBox" 
                 Grid.Row="0"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Border CornerRadius="10" 
                                Padding="10,5" 
                                MaxWidth="400"
                                HorizontalAlignment="{Binding Alignment}"
                                Background="{Binding BubbleColor}">
                            <StackPanel>
                                <TextBlock Text="{Binding SenderName}" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Visibility="{Binding ShowSender}"/>
                                <TextBlock Text="{Binding Text}" 
                                           FontSize="14"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Time}" 
                                           FontSize="10" 
                                           Foreground="Gray"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageTextBox" 
                     Grid.Column="0"
                     VerticalAlignment="Center"
                     AcceptsReturn="False"/>
            <Button x:Name="SendButton"
                    Grid.Column="1" 
                    Content="Send" 
                    Width="70" 
                    Margin="10,0,0,0"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>