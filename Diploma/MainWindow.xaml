<Window x:Class="Diploma.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:Diploma"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Diploma Messenger" Height="650" Width="950"
        MinHeight="450" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ===== Message bubble template (unchanged, just moved here) ===== -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="5" HorizontalAlignment="Stretch">
                <Border x:Name="Bubble"
                        CornerRadius="10"
                        Padding="10,5"
                        MaxWidth="400"
                        HorizontalAlignment="Left"
                        Background="#E0E0E0">
                    <StackPanel>
                        <!-- Selectable text (like Telegram) -->
                        <TextBox Text="{Binding Text}" 
                                 FontSize="14" 
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 CaretBrush="Transparent"
                                 Style="{x:Null}">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Click="CopyMessage_Click"/>
                                    <MenuItem Header="Delete" Click="DeleteMessage_Click" 
                                              Tag="{Binding MessageId}"/>
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Time}"
                                       FontSize="10"
                                       Foreground="Gray"/>
                            <TextBlock Text="{Binding StatusIcon}"
                                       FontSize="10"
                                       Foreground="Gray"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter TargetName="Bubble"
                            Property="HorizontalAlignment"
                            Value="Right"/>
                    <Setter TargetName="Bubble"
                            Property="Background"
                            Value="#0078D7"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsMine}" Value="False">
                    <Setter TargetName="Bubble"
                            Property="HorizontalAlignment"
                            Value="Left"/>
                    <Setter TargetName="Bubble"
                            Property="Background"
                            Value="#E0E0E0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Date separator template ===== -->
        <DataTemplate x:Key="DateSeparatorTemplate">
            <TextBlock Text="{Binding Text}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#888888"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,5"/>
        </DataTemplate>

        <!-- ===== Template selector ===== -->
        <local:MessageTemplateSelector x:Key="MessageTemplateSelector"
                                       MessageTemplate="{StaticResource MessageTemplate}"
                                       DateSeparatorTemplate="{StaticResource DateSeparatorTemplate}"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Chat area -->
        </Grid.ColumnDefinitions>

        <!-- ========== SIDEBAR ========== -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
        BorderBrush="{DynamicResource SystemControlForegroundChromeHighBrush}"
        BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Add friend -->
                    <RowDefinition Height="Auto"/>
                    <!-- Friend requests header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Friend requests list (fixed height) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Chats header -->
                    <RowDefinition Height=" *"/>
                    <!-- Chat list (remaining space) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Settings button -->
                </Grid.RowDefinitions>

                <!-- Add friend by username -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Add friend" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="FriendUsernameBox" Height="30" FontSize="14"
                     ui:ControlHelper.PlaceholderText="Username"
                     KeyDown="FriendUsernameBox_KeyDown"
                     TextChanged="FriendUsernameBox_TextChanged"/>
                    <Button x:Name="AddFriendButton" Content="Send request" Margin="0,5,0,0"
                    Height="30" Click="AddFriendButton_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>

                <!-- Friend requests section -->
                <TextBlock x:Name="FriendRequestsHeader" Grid.Row="1" Text="Friend requests" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <ListBox x:Name="FriendRequestsListBox" Grid.Row="2"
         BorderThickness="0" Background="Transparent"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.CanContentScroll="True"
         VirtualizingPanel.ScrollUnit="Pixel"
         KeyboardNavigation.TabNavigation="None"
         KeyboardNavigation.DirectionalNavigation="None"
         KeyboardNavigation.ControlTabNavigation="None"
         MaxHeight="80"
         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <!-- username, truncates if too long -->
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Username: limited width, truncates with "..." -->
                                <TextBlock Text="{Binding FromDisplayName}" VerticalAlignment="Center"
                        MaxWidth="120" TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FromDisplayName}"/>

                                <!-- Accept button: fixed size, text fits -->
                                <Button Content="Accept" Grid.Column="1" Margin="8,0,0,0"
                        Click="AcceptRequest_Click"
                        Tag="{Binding RequestId}" Width="68" Height="24" FontSize="11"
                        VerticalAlignment="Center" Padding="4,0"/>

                                <!-- Decline button: same as Accept -->
                                <Button Content="Decline" Grid.Column="2" Margin="4,0,0,0"
                        Click="DeclineRequest_Click"
                        Tag="{Binding RequestId}" Width="68" Height="24" FontSize="11"
                        VerticalAlignment="Center" Padding="4,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Chat list header -->
                <TextBlock Grid.Row="3" Text="Chats" FontWeight="SemiBold" Margin="0,10,0,5"/>

                <!-- Chat list (contacts) -->
                <ListBox x:Name="ChatListBox"
         Grid.Row="4"
         BorderThickness="0"
         Background="Transparent"
         SelectionChanged="ChatListBox_SelectionChanged"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         ScrollViewer.CanContentScroll="True"
         VirtualizingPanel.ScrollUnit="Pixel"
         KeyboardNavigation.TabNavigation="None"
         KeyboardNavigation.DirectionalNavigation="None"
         KeyboardNavigation.ControlTabNavigation="None"
         PreviewKeyDown="ChatListBox_PreviewKeyDown"
         PreviewMouseLeftButtonDown="ChatListBox_PreviewMouseLeftButtonDown"
         PreviewMouseLeftButtonUp="ChatListBox_PreviewMouseLeftButtonUp"
         PreviewMouseRightButtonDown="ChatListBox_PreviewMouseRightButtonDown">
                    <ListBox.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
                    </ListBox.Resources>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1F6FEB"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0F000000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Clear history" Click="ClearHistory_Click" 
                      Tag="{Binding ConversationId}"/>
                                        <MenuItem Header="Delete friend" Click="DeleteFriend_Click"
                      Tag="{Binding ContactId}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar with online dot -->
                                <Grid Width="44" Height="44" Margin="0,0,12,0">
                                    <Ellipse Fill="#E5E7EB"/>
                                    <TextBlock Text="{Binding Initials}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>
                                    <Ellipse Width="10" Height="10"
                             Fill="#22C55E"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,1,1"
                             Stroke="White"
                             StrokeThickness="2"
                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>

                                <!-- Name + last message -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ContactName}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="220"
                               ToolTip="{Binding ContactName}"/>

                                    <TextBlock Text="{Binding LastMessage}"
                               Margin="0,3,0,0"
                               FontSize="12.5"
                               Foreground="#6B7280"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="240"/>
                                </StackPanel>

                                <!-- Right column: time + marks + unread bubble -->
                                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Right">

                                    <!-- Time and status marks together -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding LastMessageTimeText}"
                                   FontSize="10.5"
                                   Foreground="#9CA3AF"/>
                                        <TextBlock Text="{Binding LastMessageStatusIcon}"
                                   FontSize="10.5"
                                   Foreground="#9CA3AF"
                                   Margin="4,0,0,0"
                                   Width="14"/>
                                    </StackPanel>

                                    <!-- Unread bubble (only if HasUnread) -->
                                    <Border Width="22"
                            Height="22"
                            Margin="0,6,0,0"
                            Background="#1F6FEB"
                            CornerRadius="11"
                            HorizontalAlignment="Right"
                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding UnreadCount}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Settings button -->
                <Button Grid.Row="5" Content="⚙ Settings" HorizontalAlignment="Left"
                Height="32" Margin="0,10,0,0" Click="SettingsButton_Click"/>
            </Grid>
        </Border>

        <!-- ========== CHAT AREA ========== -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Chat header -->
                <RowDefinition Height="*"/>
                <!-- Messages -->
                <RowDefinition Height="Auto"/>
                <!-- Input -->
            </Grid.RowDefinitions>

            <!-- Header with selected contact name -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="ChatHeaderText" Text="Select a chat" FontSize="18" FontWeight="SemiBold"
           Cursor="Hand" MouseLeftButtonDown="ChatHeaderText_MouseLeftButtonDown"/>
                <TextBlock x:Name="OnlineStatusText" FontSize="12" Foreground="LimeGreen" Visibility="Collapsed"/>
            </StackPanel>

            <ListBox x:Name="MessagesListBox"
                     Grid.Row="1"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     KeyboardNavigation.TabNavigation="None"
                     KeyboardNavigation.ControlTabNavigation="None"
                     ItemTemplateSelector="{StaticResource MessageTemplateSelector}">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Input area -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageTextBox" 
                         Grid.Column="0"
                         VerticalAlignment="Center"
                         AcceptsReturn="False"
                         FontSize="14" Height="32"
                         KeyDown="MessageTextBox_KeyDown"
                         TextChanged="MessageTextBox_TextChanged"/>
                <Button x:Name="SendButton"
                        Grid.Column="1" 
                        Content="Send" 
                        Width="70" 
                        Margin="10,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SendButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>