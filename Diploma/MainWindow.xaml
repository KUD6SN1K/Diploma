<Window x:Class="Diploma.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Diploma Messenger" Height="650" Width="950"
        MinHeight="450" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Chat area -->
        </Grid.ColumnDefinitions>

        <!-- ========== SIDEBAR ========== -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
        BorderBrush="{DynamicResource SystemControlForegroundChromeHighBrush}"
        BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Add friend -->
                    <RowDefinition Height="Auto"/>
                    <!-- Friend requests header -->
                    <RowDefinition Height="80"/>
                    <!-- Friend requests list (fixed height) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Chats header -->
                    <RowDefinition Height="*"/>
                    <!-- Chat list (remaining space) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Settings button -->
                </Grid.RowDefinitions>

                <!-- Add friend by username -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Add friend" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="FriendUsernameBox" Height="30" FontSize="14"
                     ui:ControlHelper.PlaceholderText="Username"/>
                    <Button x:Name="AddFriendButton" Content="Send request" Margin="0,5,0,0"
                    Height="30" Click="AddFriendButton_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>

                <!-- Friend requests section -->
                <TextBlock Grid.Row="1" Text="Friend requests" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <ListBox x:Name="FriendRequestsListBox" Grid.Row="2"
         BorderThickness="0" Background="Transparent"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <!-- username, truncates if too long -->
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Username: limited width, truncates with "..." -->
                                <TextBlock Text="{Binding FromUsername}" VerticalAlignment="Center"
                           MaxWidth="120" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FromUsername}"/>

                                <!-- Accept button: fixed size, text fits -->
                                <Button Content="Accept" Grid.Column="1" Margin="8,0,0,0"
                        Click="AcceptRequest_Click"
                        Tag="{Binding RequestId}" Width="68" Height="24" FontSize="11"
                        VerticalAlignment="Center" Padding="4,0"/>

                                <!-- Decline button: same as Accept -->
                                <Button Content="Decline" Grid.Column="2" Margin="4,0,0,0"
                        Click="DeclineRequest_Click"
                        Tag="{Binding RequestId}" Width="68" Height="24" FontSize="11"
                        VerticalAlignment="Center" Padding="4,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Chat list header -->
                <TextBlock Grid.Row="3" Text="Chats" FontWeight="SemiBold" Margin="0,10,0,5"/>

                <!-- Chat list (contacts) -->
                <ListBox x:Name="ChatListBox" Grid.Row="4"
         BorderThickness="0" Background="Transparent"
         SelectionChanged="ChatListBox_SelectionChanged"
         HorizontalContentAlignment="Stretch">
                    <ListBox.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left area -->
                                <StackPanel Grid.Column="0">
                                    <!-- Name + green dot -->
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="LimeGreen" 
                                 VerticalAlignment="Center" Margin="0,0,5,0"
                                 Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding ContactName}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180"
                                   ToolTip="{Binding ContactName}"/>
                                    </StackPanel>

                                    <!-- Preview row -->
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                   Text="{Binding LastMessage}" FontSize="12" Foreground="Gray" 
                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding LastMessageTimeText}" FontSize="10" 
                                       Foreground="Gray"/>
                                            <TextBlock Text="{Binding LastMessageStatusIcon}" FontSize="10" 
                                       Foreground="Gray" Margin="4,0,0,0"
                                       Width="14"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Unread bubble -->
                                <Border Grid.Column="1" 
                        Width="22" Height="22" 
                        Background="Gray" CornerRadius="11"
                        VerticalAlignment="Center" Margin="8,0,0,0"
                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding UnreadCount}" 
                               Foreground="White" FontSize="11" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Settings button -->
                <Button Grid.Row="5" Content="⚙ Settings" HorizontalAlignment="Left"
                Height="32" Margin="0,10,0,0" Click="SettingsButton_Click"/>
            </Grid>
        </Border>

        <!-- ========== CHAT AREA ========== -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Chat header -->
                <RowDefinition Height="*"/>
                <!-- Messages -->
                <RowDefinition Height="Auto"/>
                <!-- Input -->
            </Grid.RowDefinitions>

            <!-- Header with selected contact name -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="ChatHeaderText" Text="Select a chat" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="OnlineStatusText" FontSize="12" Foreground="LimeGreen" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Messages list -->
            <ListBox x:Name="MessagesListBox" 
         Grid.Row="1"
         BorderThickness="0"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.CanContentScroll="False">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Border CornerRadius="10" 
                        Padding="10,5" 
                        MaxWidth="400"
                        HorizontalAlignment="{Binding Alignment}"
                        Background="{Binding BubbleColor}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="CopyMessage_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <!-- Sender name removed – chat header already shows it -->
                                    <TextBlock Text="{Binding Text}" 
                                   FontSize="14"
                                   TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Time}" FontSize="10" Foreground="Gray"/>
                                        <TextBlock Text="{Binding StatusIcon}" FontSize="10" Foreground="Gray" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Input area -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageTextBox" 
                         Grid.Column="0"
                         VerticalAlignment="Center"
                         AcceptsReturn="False"
                         FontSize="14" Height="32"/>
                <Button x:Name="SendButton"
                        Grid.Column="1" 
                        Content="Send" 
                        Width="70" 
                        Margin="10,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SendButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>