<Window x:Class="Diploma.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Register" Height="550" Width="450" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Create account" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <TextBlock Text="Username" Margin="0,5,0,0"/>
            <TextBox x:Name="UsernameBox" Margin="0,2,0,10" Height="38"/>

            <TextBlock Text="Display name" Margin="0,5,0,0"/>
            <TextBox x:Name="DisplayNameBox" Margin="0,2,0,10" Height="38"/>

            <TextBlock Text="Password" Margin="0,5,0,0"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,2,0,10" Height="38"/>

            <TextBlock Text="Confirm password" Margin="0,5,0,0"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,2,0,10" Height="38"/>

            <Button Content="Register" Click="RegisterButton_Click"
                    Margin="0,15,0,5" Height="35"
                    Style="{DynamicResource AccentButtonStyle}"/>
            <Button Content="Back to login" Click="BackButton_Click"
                    Height="35"/>
            <TextBlock x:Name="StatusText" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>