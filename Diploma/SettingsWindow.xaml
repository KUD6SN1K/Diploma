<Window x:Class="Diploma.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Settings" Height="480" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <TextBlock Text="Display Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="DisplayNameTextBox" Height="32" FontSize="14"/>

            <TextBlock Text="Change Password" FontWeight="SemiBold" Margin="0,20,0,5"/>
            <PasswordBox x:Name="CurrentPasswordBox" Height="32" FontSize="14"
             ui:ControlHelper.PlaceholderText="Current password"/>
            <PasswordBox x:Name="NewPasswordBox" Height="32" FontSize="14" Margin="0,8,0,0"
             ui:ControlHelper.PlaceholderText="New password"/>
            <PasswordBox x:Name="ConfirmNewPasswordBox" Height="32" FontSize="14" Margin="0,8,0,0"
             ui:ControlHelper.PlaceholderText="Confirm new password"/>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <ui:ToggleSwitch x:Name="BlockRequestsToggle" Header="Block friend requests"
                     OffContent="Off" OnContent="On"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button Content="Save" Width="80" Height="30"
                        Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>